# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
package-lock.json
yarn.lock
bun.lock

# testing and coverage
/coverage
/playwright-report
/test-results
/.nyc_output

# next.js
/.next/
/out/

# production build
/build

# misc
.DS_Store
*.pem

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files, but keep the committed examples
.env
.env.*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors and local tooling
.idea/
.kiro/

# clerk configuration (can include secrets)
/.clerk/

# cursor
.cursorrules
/memory-bank

# Sentry config file
.env.sentry-build-plugin

# Python evaluation service
services/evals/.venv/
services/evals/__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
services/evals/.env

# local databases
*.sqlite
*.sqlite3
*.db
/pgdata/

# local git bundle backups
*.bundle

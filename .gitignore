/node_modules
/.pnp
.pnp.js
package-lock.json
yarn.lock
bun.lock

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*


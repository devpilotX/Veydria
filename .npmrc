legacy-peer-deps=true
shamefully-hoist=true 
# added this to fix sentry warning 
# https://docs.sentry.io/platforms/javascript/troubleshooting/#pnpm-resolving-import-in-the-middle-external-package-errors

# sharp and esbuild ship prebuilt binaries, so their optional build scripts
# are not required. Skip the pre-run dependency gate that otherwise blocks
# pnpm scripts on the pending build-script approval.
verify-deps-before-run=false

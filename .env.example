# Veydria environment configuration
# Copy this file to .env and fill in the values. Never commit .env.
# The app boots in development without most keys. See notes per section.

# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
# Public base URL, used for canonical links, sitemap, and OG images.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------
# Local example: postgresql://postgres:password@localhost:5432/agentproof
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentproof"

# ------------------------------------------------------------------
# Authentication (Clerk)
# ------------------------------------------------------------------
# Leave both blank to use Clerk keyless mode during local development. Keyless
# shows a temporary "Configure your application" widget. Setting real keys turns
# it off. Use pk_test_/sk_test_ locally and pk_live_/sk_live_ in production.
# Get them from https://dashboard.clerk.com under API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard/overview"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard/overview"

# Clerk webhook signing secret, used to sync users and organizations.
# Found in Clerk Dashboard > Webhooks. Example: whsec_...
CLERK_WEBHOOK_SECRET=

# ------------------------------------------------------------------
# Billing (Stripe)
# ------------------------------------------------------------------
# Used where Clerk Billing is not enough: checkout, portal, webhooks.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------
# LLM gateway (provider agnostic)
# ------------------------------------------------------------------
# Pick the active provider: openai, anthropic, or google.
LLM_PROVIDER="openai"
LLM_DEFAULT_MODEL="gpt-4o-mini"
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ------------------------------------------------------------------
# Evaluation service (FastAPI, services/evals)
# ------------------------------------------------------------------
EVALS_SERVICE_URL="http://localhost:8000"
# Shared secret the web app sends to the evals service.
EVALS_SERVICE_API_KEY="dev-evals-key-change-me"

# ------------------------------------------------------------------
# Observability (Langfuse)
# ------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL="https://cloud.langfuse.com"

# ------------------------------------------------------------------
# Product analytics (PostHog)
# ------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ------------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Veydria <notifications@veydria.com>"

# ------------------------------------------------------------------
# Audit log integrity
# ------------------------------------------------------------------
# HMAC key that signs each audit log row so the hash chain cannot be forged.
AUDIT_LOG_SECRET="dev-audit-secret-change-me"

# ------------------------------------------------------------------
# Error tracking (Sentry, optional)
# ------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Set to "true" to disable Sentry in development.
NEXT_PUBLIC_SENTRY_DISABLED="true"

# ------------------------------------------------------------------
# Build
# ------------------------------------------------------------------
# Set to "true" for Docker or self-hosted standalone output.
BUILD_STANDALONE=

# Veydria production environment configuration
# Copy this file to .env.production on the host and fill in real values.
# Never commit .env.production. Every value below is a placeholder.
# Production must use its own strong secrets, not the local development defaults.

# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
# The real public base URL. Used for canonical links, sitemap, and OG images.
NEXT_PUBLIC_APP_URL="https://veydria.com"

# ------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------
# The compose Postgres service reads these three. Use a strong random password.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-strong-random-password"
POSTGRES_DB="agentproof"
# The app connects with this. For the compose stack the host is the postgres
# service name. The password must match POSTGRES_PASSWORD above. The database
# name stays agentproof.
DATABASE_URL="postgresql://postgres:replace-with-a-strong-random-password@postgres:5432/agentproof"

# ------------------------------------------------------------------
# Authentication (Clerk)
# ------------------------------------------------------------------
# Use the production instance keys so the keyless widget never appears.
# Get them from https://dashboard.clerk.com under API keys for the live instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_your_production_publishable_key"
CLERK_SECRET_KEY="sk_live_your_production_secret_key"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/sign-up"
# The post sign in and sign up redirect to /dashboard/overview is set in code on
# ClerkProvider (signInForceRedirectUrl and signUpForceRedirectUrl in
# src/components/layout/providers.tsx), so it is always baked into the client
# bundle at build time. The deprecated NEXT_PUBLIC_CLERK_AFTER_* vars are not
# read by @clerk/nextjs 7 and were removed. The FALLBACK vars below are optional
# and only take effect if the code props are ever removed.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard/overview"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard/overview"

# Signing secret for the production Clerk webhook. Found in Clerk Dashboard > Webhooks.
# The webhook route passes this to verifyWebhook explicitly, so the SDK default
# CLERK_WEBHOOK_SIGNING_SECRET env var is not required.
CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_secret"

# ------------------------------------------------------------------
# Billing (Stripe)
# ------------------------------------------------------------------
# Use live mode keys. Set a price id for each paid plan.
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
STRIPE_PRICE_STARTER="price_your_starter_price_id"
STRIPE_PRICE_GROWTH="price_your_growth_price_id"
STRIPE_PRICE_SCALE="price_your_scale_price_id"

# ------------------------------------------------------------------
# LLM gateway (provider agnostic)
# ------------------------------------------------------------------
# Pick the active provider: openai, anthropic, or google. Set only the key you use.
LLM_PROVIDER="openai"
LLM_DEFAULT_MODEL="gpt-4o-mini"
OPENAI_API_KEY="your_openai_api_key"
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# ------------------------------------------------------------------
# Evaluation service (FastAPI, services/evals)
# ------------------------------------------------------------------
# For the compose stack the service is reachable by name on the internal network.
EVALS_SERVICE_URL="http://evals:8000"
# Shared secret the web app sends to the evals service. Use a strong random value.
EVALS_SERVICE_API_KEY="replace-with-a-strong-random-value"

# ------------------------------------------------------------------
# Audit log integrity
# ------------------------------------------------------------------
# HMAC key that signs each audit log row so the hash chain cannot be forged.
# Required in production. The app throws on boot if this is unset or left as the
# development default, so set a strong unique random value here.
AUDIT_LOG_SECRET="replace-with-a-strong-random-value"

# ------------------------------------------------------------------
# Error tracking (Sentry, optional)
# ------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ORG=""
NEXT_PUBLIC_SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# Set to "false" in production to enable Sentry, or "true" to keep it off.
NEXT_PUBLIC_SENTRY_DISABLED="false"

# ------------------------------------------------------------------
# Build
# ------------------------------------------------------------------
# Set to "true" for the Docker or self hosted standalone output.
BUILD_STANDALONE="true"
